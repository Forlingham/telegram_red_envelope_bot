# Database
DATABASE_URL="postgresql://DATABASE_USER:DATABASE_PASS@localhost:5432/scash_bot?schema=public"

# Scash Node RPC
SCASH_RPC_URL="http://127.0.0.1:18443"
SCASH_RPC_USER="scash"
SCASH_RPC_PASS="scash"

# ZMQ 配置 - 监听区块和交易
ZMQ_BLOCK_URL=tcp://127.0.0.1:28444
ZMQ_TX_URL=tcp://127.0.0.1:28445

# App
PORT=5000
MASTER_KEY="MASTER_KEY"

# Telegram
TELEGRAM_BOT_TOKEN="TELEGRAM_BOT_TOKEN"

# 统筹账户配置
# 助记词（24个单词）
POOLING_ACCOUNT_MNEMONIC="POOLING_ACCOUNT_MNEMONIC"
# 地址（从助记词派生）
POOLING_ACCOUNT_ADDRESS="POOLING_ACCOUNT_ADDRESS"
