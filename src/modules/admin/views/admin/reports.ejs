<%- include('../layout') %>
            <div class="nav">
                <a href="/reports?days=7" class="<%= days === 7 ? 'active' : '' %>">7天</a>
                <a href="/reports?days=30" class="<%= days === 30 ? 'active' : '' %>">30天</a>
                <a href="/reports?days=90" class="<%= days === 90 ? 'active' : '' %>">90天</a>
            </div>
            <div class="card">
                <h3>每日新增用户</h3>
                <table class="table">
                    <tr><th>日期</th><th>新增用户</th></tr>
                    <% daily.dailyUsers.forEach(item => { %>
                    <tr>
                        <td><%= item.date %></td>
                        <td><%= item.count %></td>
                    </tr>
                    <% }) %>
                </table>
            </div>
            <div class="card">
                <h3>每日红包数据</h3>
                <table class="table">
                    <tr><th>日期</th><th>红包数</th><th>总金额</th></tr>
                    <% daily.dailyRedPackets.forEach(item => { %>
                    <tr>
                        <td><%= item.date %></td>
                        <td><%= item.count %></td>
                        <td><%= Number(item.volume || 0).toFixed(4) %></td>
                    </tr>
                    <% }) %>
                </table>
            </div>
            <div class="card">
                <h3>每日领取数据</h3>
                <table class="table">
                    <tr><th>日期</th><th>领取数</th><th>总金额</th></tr>
                    <% daily.dailyClaims.forEach(item => { %>
                    <tr>
                        <td><%= item.date %></td>
                        <td><%= item.count %></td>
                        <td><%= Number(item.volume || 0).toFixed(4) %></td>
                    </tr>
                    <% }) %>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
