<%- include('../layout') %>
            <div class="card">
                <h3>用户列表 (共 <%= total %> 条)</h3>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Telegram ID</th>
                            <th>用户名</th>
                            <th>钱包地址</th>
                            <th>只读模式</th>
                            <th>创建时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                        <tr>
                            <td><%= user.id %></td>
                            <td><%= user.telegramId %></td>
                            <td><%= user.username || user.firstName + ' ' + (user.lastName || '') %></td>
                            <td><%= user.wallet ? user.wallet.address : '-' %></td>
                            <td><span class="badge <%= user.isWatchOnly ? 'badge-info' : 'badge-success' %>"><%= user.isWatchOnly ? '是' : '否' %></span></td>
                            <td><%= user.createdAt.toLocaleString('zh-CN') %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <div class="pagination">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/admin/users?page=<%= i %>" class="<%= page === i ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
